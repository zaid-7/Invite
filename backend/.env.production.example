# Production environment reference for the InviteCraft backend (Render).
# Copy the actual values into Render's dashboard env vars — do not commit real secrets.

# Neon (https://neon.tech) — copy the pooled connection string from your Neon project
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require"

# Upstash (https://upstash.com) — use the TLS "rediss://" URL from your Upstash Redis database
REDIS_URL="rediss://default:<password>@<upstash-host>:<port>"

# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="7d"

# Razorpay (use live keys only once KYC-verified; test keys are fine for a soft launch)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# App URLs — FRONTEND_URL accepts a comma-separated list (apex + www)
FRONTEND_URL="https://invitescraft.live,https://www.invitescraft.live"
BACKEND_URL="https://api.invitescraft.live"
NODE_ENV="production"

# Preview settings
PREVIEW_TTL_MINUTES=30
PREVIEW_MAX_VIEWS=10

# OTP settings (still mocked — see README)
OTP_TTL_SECONDS=300
OTP_LENGTH=6
